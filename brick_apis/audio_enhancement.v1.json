{
    "name": "audio_enhancement.v1",
    "description": "Enhances audio from a raw waveform.",
    "inputs": {
        "raw_wav": {
            "index": 0,
            "dtype": "float32",
            "shape": ["#num_samples"],
            "description": "Raw mono audio waveform."
        },
        "sample_rate": {
            "index": 1,
            "dtype": "int64",
            "shape": [1],
            "description": "Sample rate of the input waveform in Hz."
        }
    },
    "outputs": {
        "enhanced_wav": {
            "index": 0,
            "dtype": "float32",
            "shape": ["#num_output_samples"],
            "description": "Enhanced mono audio waveform."
        },
        "sample_rate": {
            "index": 1,
            "dtype": "int64",
            "shape": [1],
            "description": "Sample rate of the output waveform in Hz."
        }
    }
}
