@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)

set_and_check(ORT_INCLUDEDIR "@PACKAGE_PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(ORT_LIBDIR "@PACKAGE_PACKAGE_LIB_INSTALL_DIR@")

# Main target matches your previous "onnxruntime_session" concept
add_library(onnxruntime::onnxruntime_session STATIC IMPORTED)

set_target_properties(
    onnxruntime::onnxruntime_session
    PROPERTIES
        IMPORTED_LOCATION "${ORT_LIBDIR}/libonnxruntime_session.a"
        # Support BOTH include styles:
        #  - #include <onnxruntime/core/session/onnxruntime_cxx_api.h>
        #  - #include <onnxruntime_cxx_api.h>  (if you relied on adding core/session as include dir)
        INTERFACE_INCLUDE_DIRECTORIES "${ORT_INCLUDEDIR};${ORT_INCLUDEDIR}/onnxruntime/core/session"
)

include("${CMAKE_CURRENT_LIST_DIR}/onnxruntimeExtras.cmake")

target_link_libraries(onnxruntime::onnxruntime_session INTERFACE ${_onnxruntime_extra_libs} Threads::Threads)

# Apple frameworks you already had
if(APPLE)
    target_link_libraries(
        onnxruntime::onnxruntime_session
        INTERFACE "-framework Foundation" "-framework CoreFoundation"
    )
endif()

# Linux®-only extras if needed
if(UNIX AND NOT APPLE)
    target_link_libraries(onnxruntime::onnxruntime_session INTERFACE dl m)
endif()

# Convenience umbrella target
add_library(onnxruntime::onnxruntime INTERFACE IMPORTED)
target_link_libraries(onnxruntime::onnxruntime INTERFACE onnxruntime::onnxruntime_session)

include(CMakeFindDependencyMacro)
find_dependency(Protobuf CONFIG REQUIRED)

# Protobuf target name depends on what the installed package exports.
# Prefer full if present, else fall back to lite.
if(TARGET protobuf::libprotobuf)
    set(_ort_protobuf protobuf::libprotobuf)
elseif(TARGET protobuf::libprotobuf-lite)
    set(_ort_protobuf protobuf::libprotobuf-lite)
else()
    message(FATAL_ERROR "onnxruntime shim: no protobuf::libprotobuf(-lite) target found")
endif()

target_link_libraries(onnxruntime::onnxruntime_session INTERFACE ${_ort_protobuf})
