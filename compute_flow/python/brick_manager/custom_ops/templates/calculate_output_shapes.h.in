/* Fill output shapes from current input shapes; return zero on success. */
int64_t CF_CALCULATE_OUTPUT_SHAPES(
    const CF_TensorShape* input_shapes,
    size_t num_inputs,
    CF_TensorShape* output_shapes,
    size_t num_outputs);

